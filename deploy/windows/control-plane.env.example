# Replace every REPLACE_ value before installing.
# Literal KEY=VALUE syntax: no quotes, variable expansion, or inline comments.
# The installer copies this file into its protected config directory. Keep the
# original private too. Console email writes signup links into protected API logs.
# Development settings: use only with private access.
OMNARA_ALLOW_INSECURE_DEV_DEFAULTS=1
OMNARA_EMAIL_DRIVER=console
OMNARA_AUTH_SIGNUP_ENABLED=1
OMNARA_AUTH_PASSWORD_RESET_ENABLED=1
OMNARA_PUBLIC_URL=http://localhost:8088
OMNARA_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
OMNARA_LOG_LEVEL=info

# Supply independently managed PostgreSQL 18+ and Redis-compatible endpoints.
# URL-encode reserved characters in credentials; use TLS for remote services.
OMNARA_DATABASE_URL=REPLACE_DATABASE_URL
OMNARA_REDIS_URL=REPLACE_REDIS_URL
OMNARA_MIGRATION_TIMEOUT=30m

# Create the bucket before installing Omnara.
# For AWS S3, leave ENDPOINT empty and use USE_PATH_STYLE=0.
# For local RustFS, use http://127.0.0.1:9000 and USE_PATH_STYLE=1.
OMNARA_BLOB_S3_BUCKET=REPLACE_S3_BUCKET
OMNARA_BLOB_S3_REGION=REPLACE_S3_REGION
OMNARA_BLOB_S3_ENDPOINT=REPLACE_S3_ENDPOINT
OMNARA_BLOB_S3_ACCESS_KEY_ID=REPLACE_S3_ACCESS_KEY
OMNARA_BLOB_S3_SECRET_ACCESS_KEY=REPLACE_S3_SECRET_KEY
OMNARA_BLOB_S3_USE_PATH_STYLE=REPLACE_S3_USE_PATH_STYLE

OMNARA_WORKER_CAPACITY=4
OMNARA_WORKER_DRAIN_TIMEOUT=20s

# Generate two distinct random 32-byte base64 values.
OMNARA_SECRET_ENCRYPTION_KEYS={"windows":"REPLACE_ENCRYPTION_KEY"}
OMNARA_SECRET_ENCRYPTION_ACTIVE_KEY_ID=windows
OMNARA_SKILL_DOWNLOAD_SIGNING_KEY=REPLACE_SIGNING_KEY
# Back up the encryption key with the database; losing it loses access to secrets.

# The installer owns the memory/migrations paths, embedded dashboard mode,
# loopback listen addresses (set by its port parameters), and per-service PATH/TEMP/TMP settings.
