# Single-machine Windows POC only. Replace every REPLACE_ value before installing.
# Literal KEY=VALUE syntax: no quotes, variable expansion, or inline comments.
# The installer copies this file into its protected config directory. Keep the
# original private too. Console email writes signup links into protected API logs.
OMNARA_ALLOW_INSECURE_DEV_DEFAULTS=1
OMNARA_EMAIL_DRIVER=console
OMNARA_AUTH_SIGNUP_ENABLED=1
OMNARA_AUTH_PASSWORD_RESET_ENABLED=1
OMNARA_PUBLIC_URL=http://localhost:8088
OMNARA_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
OMNARA_LOG_LEVEL=info

# PostgreSQL 18+. URL-encode any reserved characters in credentials.
OMNARA_DATABASE_URL=postgres://omnara:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/omnara?sslmode=disable
OMNARA_REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/0
OMNARA_MIGRATION_TIMEOUT=30m

# Install-Dependencies.ps1 creates this bucket. The browser uses the API,
# so the S3 listener can remain bound to loopback.
OMNARA_BLOB_S3_BUCKET=omnara
OMNARA_BLOB_S3_REGION=us-east-1
OMNARA_BLOB_S3_ENDPOINT=http://127.0.0.1:9000
OMNARA_BLOB_S3_ACCESS_KEY_ID=REPLACE_S3_ACCESS_KEY
OMNARA_BLOB_S3_SECRET_ACCESS_KEY=REPLACE_S3_SECRET_KEY
OMNARA_BLOB_S3_USE_PATH_STYLE=1

OMNARA_WORKER_CAPACITY=4
OMNARA_WORKER_DRAIN_TIMEOUT=20s

# Generate two distinct random 32-byte base64 values, even for a POC.
OMNARA_SECRET_ENCRYPTION_KEYS={"windows-poc":"REPLACE_ENCRYPTION_KEY"}
OMNARA_SECRET_ENCRYPTION_ACTIVE_KEY_ID=windows-poc
OMNARA_SKILL_DOWNLOAD_SIGNING_KEY=REPLACE_SIGNING_KEY
# Back up the encryption key with the database; losing it loses access to secrets.
# Configure a model provider and its API key in the dashboard after signing up.

# The installer owns the memory/migrations paths, embedded dashboard mode,
# loopback listen addresses (8080-8083), and per-service PATH/TEMP/TMP settings.
