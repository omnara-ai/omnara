<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />
        <rule name="Omnara control plane" stopProcessing="true">
          <match url="(.*)" />
          <!-- Configure-IIS.ps1 creates this single-backend ARR farm. -->
          <action type="Rewrite" url="http://OmnaraControlPlane/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors existingResponse="PassThrough" />
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <caching enabled="false" enableKernelCache="false" />
    <security>
      <requestFiltering>
        <!-- Match the nginx gateway's 100 MiB ceiling; API limits still apply. -->
        <requestLimits maxAllowedContentLength="104857600" maxUrl="16384" maxQueryString="16384" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
