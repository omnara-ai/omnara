# Personal access token (omnara_pat_...) used for every API call.
OMNARA_API_KEY=omnara_pat_...

# Omnara API base URL.
OMNARA_API_URL=http://localhost:8080

# Existing organization to work in. When omitted, the CLI selects the token's
# only organization or shows a picker when there are several.
# OMNARA_ORG_ID=

# Project upserted by name inside the organization.
# OMNARA_PROJECT_NAME=cli-agent

# Repository cloned onto pool machines at startup (machine pool option only).
# When omitted, no clone happens.
# REPO_URI=https://github.com/omnara-ai/omnara.git

# Optional GitHub personal access token for cloning a private REPO_URI. It is
# upserted as a project-level secret and set on the machine-pool grant's
# secret env overlay, never embedded in the agent config.
# REPO_CRED=

# Prebuilt omnarad binary to run as the machine daemon. Required for the
# local machine option (e.g. build one with "go build -o omnarad ./cmd/daemon").
# OMNARAD_BINARY=/path/to/omnarad

# Directory holding the daemon token and omnarad state for this example.
# OMNARA_DAEMON_HOME=~/.omnara-cli-agent
