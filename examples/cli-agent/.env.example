# Token used for every API call: a personal access token (omnara_pat_...) or
# an org API key (omnara_org_...). Org API keys require OMNARA_ORG_ID.
OMNARA_API_KEY=omnara_pat_...

# Omnara API base URL.
OMNARA_API_URL=http://localhost:8080

# Existing organization to work in. Required with an org API key. When omitted
# (personal access tokens only), the CLI creates (or reuses) a local
# "CLI Agent" organization through an idempotent request.
# OMNARA_ORG_ID=

# Project upserted by name inside the organization.
# OMNARA_PROJECT_NAME=cli-agent

# Provider API key matching agent-profile.yaml's model.provider_config preset.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Prebuilt omnarad binary to run as the machine daemon. When omitted, the CLI
# builds one from the repository with "go build ./cmd/daemon".
# OMNARAD_BINARY=/path/to/omnarad

# Directory holding the daemon token and omnarad state for this example.
# OMNARA_DAEMON_HOME=~/.omnara-cli-agent
