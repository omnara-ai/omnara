OMNARA_API_KEY=omnara_pat_v1_...

# Organization and project containing the agent configured in agent.yaml.
OMNARA_ORG_ID=org_REPLACE_ME
OMNARA_PROJECT_ID=proj_REPLACE_ME

# Base64 value stored in the signing secret, not its sec_... ID.
WEBHOOK_SIGNING_SECRET=the-base64-value-stored-in-your-signing-secret

# Optional overrides for the API URL and receiver port.
# OMNARA_API_URL=https://api.omnara.com/v1
# PORT=3000
