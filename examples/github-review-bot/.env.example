# Public worker URL (no trailing slash).
PUBLIC_URL=https://github-review-bot.YOUR_SUBDOMAIN.workers.dev

# Org key: org member, developer access to this project.
OMNARA_API_KEY=
OMNARA_API_URL=https://api.omnara.com/v1
OMNARA_ORG_ID=
OMNARA_PROJECT_ID=

# GitHub App ID (not client ID), downloaded PEM, and webhook secret.
GITHUB_APP_ID=
# Paste the PEM on one line with literal \n between lines.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=

# Generate separately from the webhook secret: openssl rand -hex 32
REVIEW_JWT_SECRET=
