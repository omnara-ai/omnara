# Copy to .env in this directory and fill in. connect-machine.sh sources it.

# Machine token: in the Omnara web console, go to Overview > Machines >
# Connect machine, then paste the token shown once.
OMNARA_MACHINE_TOKEN=

# OMNARA_API_URL=https://omnara.example.com

# SharePoint mount (see README.md). Leave SHAREPOINT_DRIVE_ID empty to skip
# the mount. Pick ONE auth mode:

SHAREPOINT_DRIVE_ID=
# a) Delegated (no Entra app needed): run `rclone authorize "onedrive"`,
#    sign in as a user with access to the site, and paste the token JSON:
# SHAREPOINT_RCLONE_TOKEN='{"access_token":"...","refresh_token":"...","expiry":"..."}'
#
# b) Application (Entra app client credentials, needs admin consent):
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=


# Optional overrides.
# OMNARA_DOCKER_IMAGE=omnara-sharepoint-daemon
# OMNARA_DOCKER_CONTAINER=omnara-sharepoint-daemon
