# Personal access token (omnara_pat_v1_...) used for every API call.
OMNARA_API_KEY=omnara_pat_v1_...

# PostHog personal API key (phx_...). Create it with the MCP Server preset
# (https://app.posthog.com/settings/user-api-keys?preset=mcp_server), which
# scopes it to one PostHog project. The notebook upserts it as an Omnara
# project secret and Omnara sends it as the Bearer token on every MCP call;
# it never appears in the agent config or the event log.
POSTHOG_API_KEY=

# Optional: Slack app configuration token (xoxe.xoxp-...) from
# https://api.slack.com/apps, used by the notebook's Slack cell to create
# the Slack app for pulse delivery. Leave unset to skip Slack.
SLACK_APP_CONFIGURATION_TOKEN=
