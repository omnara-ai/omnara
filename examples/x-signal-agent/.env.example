# Personal access token (omnara_pat_v1_...) used for every API call.
OMNARA_API_KEY=omnara_pat_v1_...

# X (Twitter) API bearer token. demo.ts upserts it as a project secret
# and Omnara injects it on pool machines as X_BEARER_TOKEN; it never appears
# in the agent config.
X_BEARER_TOKEN=

# Optional: Slack app configuration token (xoxe.xoxp-...) from
# https://api.slack.com/apps, used once by the "Connect Slack" section. These
# tokens expire after ~12 hours; generate a fresh one when you run it.
SLACK_APP_CONFIGURATION_TOKEN=

# The Omnara API base URL is set in demo.ts (https://api.omnara.com/v1).
# For self-hosted Omnara, edit it to your server origin plus /api/v1,
# e.g. http://localhost:8080/api/v1.

# Optional: set to 1 to let demo.ts create the weekday cron trigger when run
# top to bottom.
SCHEDULE_DAILY=
