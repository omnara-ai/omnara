# An organization API key (omnara_org_v1_…) with the "developer" role on one project.
# It stays on your server; the browser never sees it.
OMNARA_API_KEY=
OMNARA_ORG_ID=
OMNARA_PROJECT_ID=
# OMNARA_API_URL=https://api.omnara.com/v1

# Signs the guide's session tokens. Defaults to the API key; set your own in production.
# GUIDE_SESSION_SECRET=

# --- Only for "pnpm run try" (try/proxy.ts) ---
# The app to try the guide on.
APP_URL=http://localhost:3000
# PORT=3200
# GUIDE_TITLE=Ask Acme
# GUIDE_ACCENT=#4f46e5
# GUIDE_SUGGESTIONS=How do I invite a teammate?|Where are my invoices?
# GUIDE_SHOW_ONLY=true
# A path on your app that returns the signed-in user as JSON. Without it, everyone who
# opens the proxy is one trial user.
# GUIDE_ME_PATH=/api/me
