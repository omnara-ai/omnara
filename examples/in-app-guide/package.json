{
  "name": "omnara-in-app-guide-example",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "render": "node scripts/render-agent.mjs",
    "sync": "node --env-file=.env scripts/sync-knowledge.mjs",
    "build:embed": "node scripts/build-embed.mjs",
    "try": "node scripts/build-embed.mjs && node --experimental-transform-types --env-file=.env try/proxy.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
