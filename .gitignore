# Frontend (frontend/): commit source, ignore deps and build output.
# frontend/apps/web/dist/.gitkeep is kept so //go:embed all:dist always compiles.
frontend/**/node_modules/
frontend/apps/web/dist/*
!frontend/apps/web/dist/.gitkeep
frontend/apps/web/playwright-report/
frontend/apps/web/test-results/
frontend/**/*.tsbuildinfo
internal/blackbox/*.log
blackbox-run.log
