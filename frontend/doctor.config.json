{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        "files": ["src/domains/scoped-mutation.ts"],
        "rules": ["react-doctor/query-mutation-missing-invalidation"]
      },
      {
        "files": ["src/components/agents/AgentConfigYamlEditor.tsx"],
        "rules": ["react-doctor/prefer-dynamic-import"]
      },
      {
        "files": ["src/components/active-org/ActiveOrgProvider.tsx"],
        "rules": ["react-doctor/no-event-handler"]
      },
      {
        "files": [
          "src/components/agents/AgentConfigMachineSourceComboboxes.tsx",
          "src/components/agents/AgentConfigMachineSourcesField.tsx",
          "src/components/agents/AgentConfigModelField.tsx",
          "src/components/agents/AgentConfigSkillsField.tsx",
          "src/components/agents/useAgentConfigEditor.ts"
        ],
        "rules": [
          "react-doctor/no-pass-data-to-parent",
          "react-doctor/no-pass-live-state-to-parent",
          "react-doctor/no-prop-callback-in-effect"
        ]
      }
    ]
  },
  "projects": ["packages/react", "apps/web"]
}
