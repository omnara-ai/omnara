{
  "name": "@omnara/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./tanstack": {
      "types": "./src/generated/@tanstack/react-query.gen.ts",
      "default": "./src/generated/@tanstack/react-query.gen.ts"
    },
    "./zod": {
      "types": "./src/generated/zod.gen.ts",
      "default": "./src/generated/zod.gen.ts"
    }
  },
  "scripts": {
    "generate:api": "openapi-ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.59.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tanstack/react-query": "^5.59.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.9"
  }
}
