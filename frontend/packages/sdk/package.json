{
  "name": "@omnara/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for the Omnara API, with browser, TanStack Query, and Zod entry points",
  "license": "Apache-2.0",
  "homepage": "https://omnara.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnara-ai/omnara.git",
    "directory": "frontend/packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./tanstack": {
      "types": "./src/generated/@tanstack/react-query.gen.ts",
      "default": "./src/generated/@tanstack/react-query.gen.ts"
    },
    "./zod": {
      "types": "./src/generated/zod.gen.ts",
      "default": "./src/generated/zod.gen.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./tanstack": {
        "types": "./dist/tanstack.d.ts",
        "default": "./dist/tanstack.js"
      },
      "./zod": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "generate:api": "openapi-ts && node scripts/relax-response-enums.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.59.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tanstack/react-query": "^5.59.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "4.1.9"
  }
}
