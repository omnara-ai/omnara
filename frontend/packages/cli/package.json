{
  "name": "omnara",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "omnara": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/bin.js --banner:js='#!/usr/bin/env node' --external:@clack/prompts --external:commander --external:tar --external:yaml --external:zod",
    "prepublishOnly": "pnpm build",
    "omnara": "tsx src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.0",
    "tar": "^7.5.22",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@omnara/sdk": "workspace:*",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.9"
  }
}
