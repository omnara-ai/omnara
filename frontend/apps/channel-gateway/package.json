{
  "name": "@omnara/channel-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:journey": "esbuild src/testdata/slack-journey.ts src/testdata/discord-journey.ts src/testdata/github-journey.ts --bundle --platform=node --format=cjs --target=node24 --outdir=../../../.local/channel-gateway --out-extension:.js=.cjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/rest": "2.6.3",
    "@discordjs/ws": "2.0.4",
    "@fastify/busboy": "3.2.2",
    "@hono/node-server": "2.1.1",
    "@octokit/auth-app": "8.3.1",
    "hono": "4.13.7",
    "redis": "5.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@omnara/sdk": "workspace:*",
    "@slack/web-api": "7.19.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "graphql": "16.14.2",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "4.1.9"
  }
}
