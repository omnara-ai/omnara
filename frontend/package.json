{
  "name": "@omnara/frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @omnara/web dev",
    "build": "pnpm --filter @omnara/web build",
    "preview": "pnpm --filter @omnara/web preview",
    "generate:api": "pnpm --filter @omnara/sdk generate:api",
    "doctor": "npx --yes react-doctor@latest . --project \"*\" --scope full --blocking warning",
    "doctor:changed": "npx --yes react-doctor@latest . --project \"*\" --scope changed --blocking warning",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0"
  }
}
