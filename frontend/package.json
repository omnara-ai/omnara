{
  "name": "@omnara/frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @omnara/web dev",
    "build": "pnpm --filter @omnara/web build",
    "preview": "pnpm --filter @omnara/web preview",
    "generate:api": "pnpm --filter @omnara/sdk generate:api",
    "doctor": "npx --yes react-doctor@latest . --project \"*\" --scope changed --blocking warning",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "typescript": "^5.6.0"
  }
}
