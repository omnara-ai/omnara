{
  "title": "Model calls",
  "uid": "omnara-model-calls",
  "description": "Per-attempt model provider latency (TTFT and duration), request size, tokens, cache hit ratio, and outcomes from omnara_model_call_* metrics. Exact per-attempt values are in model.call log events.",
  "tags": [
    "omnara",
    "model"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "api_format",
        "label": "API",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(omnara_model_call_attempts_total, api_format)",
          "refId": "api_format"
        },
        "definition": "label_values(omnara_model_call_attempts_total, api_format)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(omnara_model_call_attempts_total{api_format=~\"$api_format\"}, provider)",
          "refId": "provider"
        },
        "definition": "label_values(omnara_model_call_attempts_total{api_format=~\"$api_format\"}, provider)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(omnara_model_call_attempts_total{api_format=~\"$api_format\",provider=~\"$provider\"}, model)",
          "refId": "model"
        },
        "definition": "label_values(omnara_model_call_attempts_total{api_format=~\"$api_format\",provider=~\"$provider\"}, model)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Attempts / s by model, provider, and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, provider, outcome) (rate(omnara_model_call_attempts_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}} / {{provider}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Every provider attempt, retries and failures included."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failed attempts / s by error kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, provider, error_kind) (rate(omnara_model_call_attempts_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\",outcome=\"error\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}} / {{provider}} / {{error_kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p50 TTFT by model / provider",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, model, provider) (rate(omnara_model_call_ttft_seconds_bucket{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}} / {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Request start to the first streamed token: text, reasoning, tool-call name, or arguments. Unlike http.subrequests total_ms, which stops at response headers."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p90 TTFT by model / provider",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.9, sum by (le, model, provider) (rate(omnara_model_call_ttft_seconds_bucket{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{model}} / {{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Request start to the first streamed token: text, reasoning, tool-call name, or arguments. Unlike http.subrequests total_ms, which stops at response headers."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit ratio by provider",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(omnara_model_call_cached_input_tokens_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__rate_interval])) / sum by (provider) (rate(omnara_model_call_cache_reported_input_tokens_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "description": "Share of input tokens read from the prompt cache, over attempts whose provider reported a cache-read count. Providers that never report one have no line."
    },
    {
      "id": 6,
      "type": "table",
      "title": "Average TTFT and duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "ttft",
          "expr": "sum by (model, provider) (increase(omnara_model_call_ttft_seconds_sum{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])) / sum by (model, provider) (increase(omnara_model_call_ttft_seconds_count{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "duration",
          "expr": "sum by (model, provider) (increase(omnara_model_call_duration_seconds_sum{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])) / sum by (model, provider) (increase(omnara_model_call_duration_seconds_count{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "samples",
          "expr": "round(sum by (model, provider) (increase(omnara_model_call_ttft_seconds_count{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "model": 0,
              "provider": 1,
              "Value #samples": 2,
              "Value #ttft": 3,
              "Value #duration": 4
            },
            "renameByName": {
              "Value #samples": "TTFT samples",
              "Value #ttft": "avg TTFT",
              "Value #duration": "avg duration"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "TTFT samples"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "description": "Mean seconds from request start to the first streamed token and to the end of the attempt."
    },
    {
      "id": 7,
      "type": "table",
      "title": "Per-attempt averages",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "bytes",
          "expr": "sum by (model, provider) (increase(omnara_model_call_request_bytes_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])) / sum by (model, provider) (increase(omnara_model_call_duration_seconds_count{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "input",
          "expr": "sum by (model, provider) (increase(omnara_model_call_input_tokens_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])) / (sum by (model, provider) (increase(omnara_model_call_duration_seconds_count{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])) - sum by (model, provider) (increase(omnara_model_call_usage_missing_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "cached",
          "expr": "sum by (model, provider) (increase(omnara_model_call_cached_input_tokens_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])) / sum by (model, provider) (increase(omnara_model_call_cache_reported_input_tokens_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "output",
          "expr": "sum by (model, provider) (increase(omnara_model_call_output_tokens_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])) / (sum by (model, provider) (increase(omnara_model_call_duration_seconds_count{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])) - sum by (model, provider) (increase(omnara_model_call_usage_missing_total{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "attempts",
          "expr": "round(sum by (model, provider) (increase(omnara_model_call_duration_seconds_count{api_format=~\"$api_format\",provider=~\"$provider\",model=~\"$model\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #bytes": "avg request bytes",
              "Value #input": "avg input tokens",
              "Value #cached": "cache hit ratio",
              "Value #output": "avg output tokens",
              "Value #attempts": "attempts"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cache hit ratio"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "description": "Token averages are over attempts that reported usage; the cache hit ratio is over attempts that reported a cache-read count."
    }
  ]
}
