{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Omnara",
  "seo": {
    "metatags": {
      "canonical": "https://docs.omnara.com",
      "og:site_name": "Omnara Docs",
      "twitter:card": "summary_large_image"
    }
  },
  "logo": {
    "dark": "/logo/omnara-logo.svg",
    "light": "/logo/omnara-logo-light.svg"
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#5e6ad2",
    "light": "#8188df",
    "dark": "#4e59c7"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0b0b0c"
    }
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "/support"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/omnara-ai/omnara"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://app.omnara.com"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Discord",
          "icon": "discord",
          "href": "https://discord.gg/Dc46sYk6e3"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "how-omnara-works"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "agents/overview",
              "agents/configuration"
            ]
          },
          {
            "group": "Inputs & events",
            "pages": [
              "events/sending-input",
              "events/streaming",
              "events/interactions",
              "events/artifacts"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "tools/permissions",
              "tools/built-in",
              "tools/custom",
              "tools/mcp",
              "tools/skills"
            ]
          },
          {
            "group": "Machines",
            "pages": [
              "machines/overview",
              "machines/connect",
              "machines/pools"
            ]
          },
          {
            "group": "Organization",
            "pages": [
              "organization/model-providers",
              "organization/secrets",
              "organization/members"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/slack"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/overview",
              "examples/repo-slack-agent",
              "examples/mounted-storage"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API reference",
            "pages": [
              "api/overview",
              "api/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "api-reference/openapi.yaml",
              "directory": "api-reference/endpoints"
            }
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://twitter.com/omnaraai",
      "linkedin": "https://linkedin.com/company/omnara",
      "discord": "https://discord.gg/Dc46sYk6e3"
    }
  }
}
