{
  "$defs": {
    "AgentConfigDefinitionEventWebhook": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "enum": [
              "agent_input",
              "model_output",
              "tool_result",
              "context_checkpoint",
              "tool_call_update"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "signing_secret_id": {
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url",
        "events"
      ],
      "type": "object"
    },
    "AgentConfigDefinitionGitCredentials": {
      "additionalProperties": false,
      "description": "Integration whose git credentials the agent's machines use.",
      "properties": {
        "integration": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$",
          "type": "string"
        }
      },
      "required": [
        "integration"
      ],
      "type": "object"
    },
    "AgentConfigDefinitionInteractionHandler": {
      "additionalProperties": false,
      "description": "Enables an integration's interaction handler. Takes no settings.",
      "type": "object"
    },
    "AgentConfigDefinitionInteractionHandlers": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AgentConfigDefinitionInteractionHandler"
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$",
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "Interaction handlers keyed by integration name."
    },
    "AgentConfigDefinitionMCPAuth": {
      "additionalProperties": false,
      "properties": {
        "region": {
          "minLength": 1,
          "type": "string"
        },
        "secret_id": {
          "minLength": 1,
          "pattern": "^sec_[a-z2-7]{26}$",
          "type": "string"
        },
        "service": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "bearer",
            "oauth",
            "sigv4"
          ]
        }
      },
      "required": [
        "type",
        "secret_id"
      ],
      "type": "object"
    },
    "AgentConfigDefinitionMCPServer": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "$ref": "#/$defs/AgentConfigDefinitionMCPAuth"
        },
        "default_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "deferred": {
          "type": "boolean"
        },
        "permission": {
          "$ref": "#/$defs/AgentConfigDefinitionToolPermission"
        },
        "tools": {
          "additionalProperties": {
            "$ref": "#/$defs/AgentConfigDefinitionMCPTool"
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "type": "string"
          },
          "type": "object"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "AgentConfigDefinitionMCPServers": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AgentConfigDefinitionMCPServer"
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,31}$",
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "AgentConfigDefinitionMCPTool": {
      "additionalProperties": false,
      "properties": {
        "deferred": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "permission": {
          "$ref": "#/$defs/AgentConfigDefinitionToolPermission"
        }
      },
      "type": "object"
    },
    "AgentConfigDefinitionMachineSource": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "machine_name"
          ],
          "type": "object"
        },
        {
          "required": [
            "machine_pool_name"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "cwd": {
          "maxLength": 4096,
          "type": "string"
        },
        "delete_after_idle_minutes": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 2147483647,
              "minimum": 5,
              "type": "integer"
            }
          ]
        },
        "description": {
          "maxLength": 4096,
          "type": "string"
        },
        "env_overlay": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "propertyNames": {
                "$ref": "#/$defs/EnvironmentVariableName"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "initial_num_machines": {
          "minimum": 0,
          "type": "integer"
        },
        "machine_cpu": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "machine_memory_mb": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "machine_name": {
          "$ref": "#/$defs/ResourceNameReference"
        },
        "machine_pool_name": {
          "$ref": "#/$defs/ResourceNameReference"
        },
        "machine_provider_options_overlay": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_machines": {
          "minimum": 0,
          "type": "integer"
        },
        "secret_env_overlay": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "pattern": "^sec_[a-z2-7]{26}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "propertyNames": {
                "$ref": "#/$defs/EnvironmentVariableName"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "AgentConfigDefinitionMachineSources": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/AgentConfigDefinitionMachineSource"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "AgentConfigDefinitionMemoryStore": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "enum": [
            "read",
            "read_write"
          ],
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/MemoryStoreName"
        }
      },
      "required": [
        "name",
        "access"
      ],
      "type": "object"
    },
    "AgentConfigDefinitionMemoryStores": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/AgentConfigDefinitionMemoryStore"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "AgentConfigDefinitionModel": {
      "additionalProperties": false,
      "properties": {
        "cache_retention": {
          "enum": [
            "none",
            "short",
            "long"
          ]
        },
        "context_window_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "default_max_output_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "$ref": "#/$defs/ResourceNameReference"
        },
        "provider_config": {
          "$ref": "#/$defs/ResourceNameReference"
        },
        "reasoning": {
          "additionalProperties": false,
          "properties": {
            "effort": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "required": [
            "effort"
          ],
          "type": "object"
        }
      },
      "required": [
        "provider_config",
        "name"
      ],
      "type": "object"
    },
    "AgentConfigDefinitionSkills": {
      "anyOf": [
        {
          "items": {
            "pattern": "^skl_[a-z2-7]{26}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "AgentConfigDefinitionSubagent": {
      "additionalProperties": false,
      "else": {
        "not": {
          "required": [
            "profile"
          ],
          "type": "object"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "profile"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "properties": {
        "archive_after_idle_minutes": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "instruction": {
          "$ref": "#/$defs/AgentConfigDefinitionSubagentInstruction"
        },
        "max_instances": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "model": {
          "$ref": "#/$defs/AgentConfigDefinitionSubagentModel"
        },
        "profile": {
          "$ref": "#/$defs/ResourceNameReference"
        },
        "type": {
          "enum": [
            "profile",
            "self"
          ]
        }
      },
      "required": [
        "type"
      ],
      "then": {
        "required": [
          "profile"
        ]
      },
      "type": "object"
    },
    "AgentConfigDefinitionSubagentInstruction": {
      "additionalProperties": false,
      "properties": {
        "append": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "AgentConfigDefinitionSubagentModel": {
      "additionalProperties": false,
      "dependentRequired": {
        "name": [
          "provider_config"
        ],
        "provider_config": [
          "name"
        ]
      },
      "properties": {
        "cache_retention": {
          "enum": [
            "none",
            "short",
            "long"
          ]
        },
        "context_window_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "default_max_output_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "$ref": "#/$defs/ResourceNameReference"
        },
        "provider_config": {
          "$ref": "#/$defs/ResourceNameReference"
        },
        "reasoning": {
          "additionalProperties": false,
          "properties": {
            "effort": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "required": [
            "effort"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "AgentConfigDefinitionSubagents": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AgentConfigDefinitionSubagent"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "AgentConfigDefinitionTool": {
      "additionalProperties": false,
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "description"
              ],
              "type": "object"
            },
            {
              "required": [
                "input_schema"
              ],
              "type": "object"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "custom"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "properties": {
        "deferred": {
          "type": "boolean"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_schema": {
          "$ref": "#/$defs/AgentConfigDefinitionToolInputSchema"
        },
        "permission": {
          "$ref": "#/$defs/AgentConfigDefinitionToolPermission"
        },
        "type": {
          "enum": [
            "built_in",
            "custom"
          ]
        }
      },
      "then": {
        "required": [
          "description",
          "input_schema"
        ]
      },
      "type": "object"
    },
    "AgentConfigDefinitionToolInputSchema": {
      "properties": {
        "properties": {
          "additionalProperties": {
            "type": "object"
          },
          "type": "object"
        },
        "required": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "const": "object"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "AgentConfigDefinitionToolPermission": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "AgentConfigDefinitionTools": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AgentConfigDefinitionTool"
          },
          "propertyNames": {
            "allOf": [
              {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
                    "type": "string"
                  },
                  {
                    "maxLength": 64,
                    "pattern": "^int__[a-zA-Z][a-zA-Z0-9-]{0,31}__[a-zA-Z][a-zA-Z0-9_-]*$",
                    "type": "string"
                  }
                ]
              },
              {
                "not": {
                  "pattern": "^mcp__",
                  "type": "string"
                }
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "EnvironmentVariableName": {
      "minLength": 1,
      "pattern": "^[^=\\x00]+$",
      "type": "string"
    },
    "MemoryStoreName": {
      "description": "Machine-readable memory store identifier consisting of lowercase ASCII segments separated by single hyphens.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "ResourceNameReference": {
      "description": "Name of an existing resource, resolved when the config is compiled.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An agent config as a JSON object. This schema is the source of truth for agent configs: the server compiles YAML and JSON configs against it.",
  "properties": {
    "event_webhook": {
      "$ref": "#/$defs/AgentConfigDefinitionEventWebhook"
    },
    "git_credentials": {
      "$ref": "#/$defs/AgentConfigDefinitionGitCredentials"
    },
    "instruction": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "interaction_handlers": {
      "$ref": "#/$defs/AgentConfigDefinitionInteractionHandlers"
    },
    "machine_sources": {
      "$ref": "#/$defs/AgentConfigDefinitionMachineSources"
    },
    "max_depth": {
      "maximum": 8,
      "minimum": 1,
      "type": "integer"
    },
    "max_subagents": {
      "maximum": 2147483647,
      "minimum": 1,
      "type": "integer"
    },
    "mcp": {
      "$ref": "#/$defs/AgentConfigDefinitionMCPServers"
    },
    "memory_stores": {
      "$ref": "#/$defs/AgentConfigDefinitionMemoryStores"
    },
    "model": {
      "$ref": "#/$defs/AgentConfigDefinitionModel"
    },
    "skills": {
      "$ref": "#/$defs/AgentConfigDefinitionSkills"
    },
    "subagents": {
      "$ref": "#/$defs/AgentConfigDefinitionSubagents"
    },
    "tools": {
      "$ref": "#/$defs/AgentConfigDefinitionTools"
    },
    "version": {
      "enum": [
        "v1"
      ]
    }
  },
  "required": [
    "instruction",
    "model"
  ],
  "type": "object"
}
